# TechQuiz na VPS: copie este arquivo para ".env" (na mesma pasta do docker-compose.prod.yml) e preencha.
# NUNCA coloque o .env no Git (o .gitignore já o ignora). Guia: docs/DEPLOY_VPS_HOSTINGER.md

# ---- Domínio e Traefik (confira os valores reais no seu Traefik; veja o guia, seção 3) ----
APP_DOMAIN=techquiz.institutoviva.digital
TRAEFIK_NETWORK=troque-pelo-nome-da-rede-do-traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# ---- Segredos (gere valores únicos; comandos no guia, seção 4) ----
# SECRET_KEY assina a sessão. GABARITO_SAL é o sal dos tokens do gabarito: NÃO troque com coleta em andamento.
SECRET_KEY=gere-uma-chave-longa-e-aleatoria
GABARITO_SAL=gere-outro-valor-longo-e-aleatorio
POSTGRES_PASSWORD=gere-uma-senha-forte

# ---- Opcionais ----
POSTGRES_DB=techquiz
POSTGRES_USER=techquiz
TIMEZONE=America/Belem
LOG_LEVEL=INFO
WEB_CONCURRENCY=3
# Identidade do painel e do jogo (logos: caminhos relativos a app/static/)
INSTITUICAO_NOME=UFRA - Universidade Federal Rural da Amazônia
INSTITUICAO_SUBTITULO=Programa de Pós-Graduação em Administração Pública - PROFIAP
LOGO_INSTITUICAO=img/logo_ufra.png
LOGO_PROGRAMA=img/logo_pos.png
# Rótulo da imagem construída (útil para guardar versões: techquiz-app:2026-11). Padrão: latest
# APP_VERSAO=latest
# Ao criar o projeto pelo painel com build a partir do Git, informe a URL (senão deixe comentado):
# APP_BUILD_CONTEXT=https://github.com/andviana/techquiz.git#main

# ---- Backup (usados por docker/backup.sh; exporte no cron ou deixe os padrões) ----
# BACKUP_DIR=./backups
# BACKUP_RETENCAO_DIAS=56
# Comando, definido por você, que copia o arquivo para FORA da VPS. Recebe o caminho em "$1".
# BACKUP_COPIA_CMD=rsync -a --chmod=F600 "$1" usuario@outro-servidor:/dados/techquiz/
