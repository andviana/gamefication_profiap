# Copie para .env e ajuste. Em produção defina tudo explicitamente (ver README_ADMIN.md).

# development | testing | production
APP_ENV=development

# Obrigatórios em produção (>= 32 e >= 16 caracteres, valores aleatórios e únicos)
SECRET_KEY=
GABARITO_SAL=

# Desenvolvimento: se vazio, usa SQLite em instance/dev.db. Produção: PostgreSQL obrigatório.
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/techquiz
DATABASE_URL=

TIMEZONE=America/Belem
LOCALE=pt-BR
LOG_LEVEL=INFO

# Sessão e login
SESSION_HORAS=8
LOGIN_MAX_FALHAS=5
LOGIN_BLOQUEIO_SEG=600

# Código de acesso: só tentativas falhas contam, por IP
RATE_LIMIT_FALHAS=10
RATE_LIMIT_JANELA_SEG=60
RATE_LIMIT_BLOQUEIO_SEG=300

# Importação de questionários
PREVIA_VALIDADE_MIN=15
UPLOAD_MAX_BYTES=2097152

# Nº de proxies reversos confiáveis (Nginx = 1) para ler o IP real em X-Forwarded-For. Sem proxy: 0.
PROXIES_CONFIAVEIS=0

# Identidade do painel. Os logos são caminhos relativos a app/static/
INSTITUICAO_NOME=UFRA - Universidade Federal Rural da Amazônia
INSTITUICAO_SUBTITULO=Programa de Pós-Graduação em Administração Pública - PROFIAP
LOGO_INSTITUICAO=img/logo_ufra.png
LOGO_PROGRAMA=img/logo_pos.png
