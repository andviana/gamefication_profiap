# /etc/systemd/system/techquiz-backup.service
[Unit]
Description=Backup do banco do TechQuiz (pg_dump)
After=postgresql.service

[Service]
Type=oneshot
User=techquiz
Group=techquiz
EnvironmentFile=/etc/techquiz/techquiz.env
ExecStart=/opt/techquiz/app/deploy/techquiz-backup.sh
# o serviço grava só no diretório de backup
ProtectSystem=strict
ReadWritePaths=/var/backups/techquiz
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
