# /etc/techquiz/techquiz.env   (dono root, grupo techquiz, modo 0640: contém segredos)
# Em produção TODAS as variáveis marcadas como obrigatórias precisam estar definidas, ou o app não sobe.

APP_ENV=production

# Obrigatórios. Gere com:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY assina a sessão (>= 32 caracteres). GABARITO_SAL é o sal dos tokens do gabarito (>= 16).
# Não troque o GABARITO_SAL depois que houver coleta em andamento: os jogos abertos deixariam de corrigir.
SECRET_KEY=
GABARITO_SAL=

# Obrigatório: PostgreSQL. Caracteres especiais na senha precisam de codificação percentual (@ vira %40).
DATABASE_URL=postgresql://techquiz:SENHA@127.0.0.1:5432/techquiz

# Nginx na frente: 1. Sem isso o rate limit enxerga todos os alunos como um IP só (o do Nginx).
PROXIES_CONFIAVEIS=1

TIMEZONE=America/Belem
LOCALE=pt-BR
LOG_LEVEL=INFO

# Valores padrão aprovados (só descomente para mudar)
# SESSION_HORAS=8
# LOGIN_MAX_FALHAS=5
# LOGIN_BLOQUEIO_SEG=600
# RATE_LIMIT_FALHAS=10
# RATE_LIMIT_JANELA_SEG=60
# RATE_LIMIT_BLOQUEIO_SEG=300
# PREVIA_VALIDADE_MIN=15
# UPLOAD_MAX_BYTES=2097152

# Identidade (cabeçalho do painel e do jogo). Logos: caminhos relativos a app/static/
INSTITUICAO_NOME=UFRA - Universidade Federal Rural da Amazônia
INSTITUICAO_SUBTITULO=Programa de Pós-Graduação em Administração Pública - PROFIAP
LOGO_INSTITUICAO=img/logo_ufra.png
LOGO_PROGRAMA=img/logo_pos.png

# gunicorn (opcionais)
# WEB_CONCURRENCY=3
# GUNICORN_THREADS=4
# GUNICORN_BIND=127.0.0.1:8000

# Backup (usados por deploy/techquiz-backup.sh)
# BACKUP_DIR=/var/backups/techquiz
# BACKUP_RETENCAO_DIAS=56
# Comando opcional, definido pela TI, que copia o arquivo para FORA do servidor. Recebe o caminho do arquivo em "$1".
# Exemplo:  BACKUP_COPIA_CMD=rsync -a --chmod=F600 "$1" backup@servidor-de-arquivos:/dados/techquiz/
# BACKUP_COPIA_CMD=
